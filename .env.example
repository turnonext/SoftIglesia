# Raíz — puertos y credenciales para Docker Compose (no es el .env de Laravel)
# Las claves APP_KEY y JWT_SECRET se generan en backend/.env con: make setup
FRONTEND_PORT=3000

NGINX_HTTP_PORT=8080
# Puerto en tu PC (no afecta backend→mysql dentro de Docker). Usa 3307 si 3306 está ocupado (XAMPP).
MYSQL_PORT=3307
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DB_DATABASE=lms_saas
DB_USERNAME=lms
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

RABBITMQ_USER=lms
RABBITMQ_PASS=secret

MINIO_USER=minio
MINIO_PASS=minio12345
